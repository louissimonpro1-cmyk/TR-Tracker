{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "public",
  "functions": {
    "api/**/*.js": { "maxDuration": 60 }
  },
  "_comment_crons": "One entry per UTC hour, all hitting the same route. Each expression still runs once a day, which is what the Hobby plan allows (the limit is per expression, and 100 entries per project are permitted). runCheck() then decides whether the hour the user picked has come in their own timezone, so the choice stays correct through DST and abroad, and only one of the 24 does real work.",
  "crons": [
    { "path": "/api/cron/check-alerts", "schedule": "0 0 * * *" },
    { "path": "/api/cron/check-alerts", "schedule": "0 1 * * *" },
    { "path": "/api/cron/check-alerts", "schedule": "0 2 * * *" },
    { "path": "/api/cron/check-alerts", "schedule": "0 3 * * *" },
    { "path": "/api/cron/check-alerts", "schedule": "0 4 * * *" },
