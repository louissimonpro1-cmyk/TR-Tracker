    { "path": "/api/cron/check-alerts", "schedule": "0 7 * * *" },
    { "path": "/api/cron/check-alerts", "schedule": "0 8 * * *" },
    { "path": "/api/cron/check-alerts", "schedule": "0 9 * * *" },
    { "path": "/api/cron/check-alerts", "schedule": "0 10 * * *" },
    { "path": "/api/cron/check-alerts", "schedule": "0 11 * * *" },
    { "path": "/api/cron/check-alerts", "schedule": "0 12 * * *" },
    { "path": "/api/cron/check-alerts", "schedule": "0 13 * * *" },
